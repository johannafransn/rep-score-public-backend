# Required: public Circles HyperIndex (Envio) token — the same one the wallet
# ships client-side (wallet/src/lib/constants/envioEndpoint.ts). Not a secret,
# but kept out of source so the repo is clean to open-source.
ENVIO_API_TOKEN=your-envio-token-here

# All optional — sensible public defaults are baked in (see src/config.ts).
# PORT=8787
# ENVIO_ENDPOINT=https://gnosis-e702590.dedicated.hyperindex.xyz/v1/graphql
# REFRESH_MS=600000
# DAMPING=0.85
# ITERATIONS=50
# PER_SOURCE_CAP=0.02
# Comma-separated anchor avatar addresses (Sybil-hardening). Empty = uniform seed.
# ANCHORS=0x...,0x...
